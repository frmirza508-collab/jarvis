# =============================================================================
# JARVIS configuration example. Copy to .env for local development.
# NEVER commit real keys. Production secrets belong in a secret manager.
# =============================================================================

# ---------------------------------------------------------------- license API (server)
DATABASE_URL=postgres://jarvis:change-me@localhost:5432/jarvis
# Ed25519 PKCS#8 private key used to sign entitlements. Generate with:
#   pnpm --filter @jarvis/license-api generate-keys
# Server-only. Never ship in the desktop app.
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_API_HOST=0.0.0.0
LICENSE_API_PORT=8787
PUBLIC_BASE_URL=https://license.example.com
# Comma-separated origins allowed to call the API from a browser (admin portal).
ADMIN_ORIGINS=https://admin.example.com
# Set to true when running behind a reverse proxy/load balancer (for client IPs / rate limits).
TRUST_PROXY=false

# Payment providers (all optional; manual bank-transfer confirmation always works)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Generic signed gateway bridge (e.g. a Pakistan payment gateway integration service)
GATEWAY_WEBHOOK_SECRET=
GATEWAY_CHECKOUT_URL=

# ---------------------------------------------------------------- admin portal (build time)
VITE_LICENSE_API_URL=https://license.example.com

# ---------------------------------------------------------------- desktop release build (build time)
# PUBLIC key matching LICENSE_SIGNING_PRIVATE_KEY (safe to embed).
JARVIS_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JARVIS_LICENSE_API_URL=https://license.example.com
# Optional customer account/purchase page shown in the Account view.
VITE_ACCOUNT_URL=https://account.example.com
# Optional Authenticode signing
JARVIS_SIGN_PFX=
JARVIS_SIGN_PASSWORD=

# ---------------------------------------------------------------- local core (development only)
# JARVIS_DEV=1 runs the core without the desktop shell (token below, port 7801).
JARVIS_DEV=1
JARVIS_DEV_TOKEN=dev-token-change-me
JARVIS_PORT=7801
# development = bypass licensing (ignored by release builds)
JARVIS_LICENSE_MODE=development
# First-run seeding of user keys (stored encrypted, then read from the secret store)
OPENROUTER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Browser used for automation. On Windows, Microsoft Edge is used automatically.
JARVIS_BROWSER_PATH=
JARVIS_LOG_LEVEL=info
